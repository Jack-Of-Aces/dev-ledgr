# Copy to .env for local development. Real environment variables take precedence.

APP_ENV=development
PORT=8080

# Supabase: Project Settings -> Database -> Connection string.
# Direct connection (port 5432) or the transaction pooler (port 6543) both work;
# the API switches to pgx's simple protocol automatically on 6543.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Next.js origin. Used for CORS and for building magic-link URLs.
FRONTEND_URL=http://localhost:3000
# Comma-separated; defaults to FRONTEND_URL.
# ALLOWED_ORIGINS=http://localhost:3000,https://devledgr.io

# >= 32 chars. Signs ledger certificates; rotating it invalidates existing stamps.
SESSION_SECRET=
# 64 hex chars (32 bytes). Encrypts BYOK API keys. Generate: openssl rand -hex 32
ENCRYPTION_KEY=
SESSION_TTL_HOURS=168
# COOKIE_DOMAIN=.devledgr.io
# COOKIE_SECURE=true

# GitHub OAuth App (same client id as NEXT_PUBLIC_GITHUB_CLIENT_ID on the frontend).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Magic-link email. Without RESEND_API_KEY links are printed to the server log (dev only).
RESEND_API_KEY=
EMAIL_FROM=DevLedgr <auth@devledgr.io>
# MAGIC_LINK_URL=http://localhost:3000/api/auth/magic

# Optional external AI gateway (POST /scrutiny, POST /coach). Unset = built-in heuristic engine.
AI_GATEWAY_URL=

# Enables POST /api/v1/auth/dev/login (persona sandbox). Refused when APP_ENV=production.
ENABLE_DEV_LOGIN=true
