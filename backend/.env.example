# Copy to .env for local development. Real environment variables take precedence.

APP_ENV=development
PORT=8080

# Supabase: Project Settings -> Database -> Connection string.
# The transaction pooler (6543) is recommended; some networks block the session pooler's port 5432.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth: Project Settings -> API.
SUPABASE_URL=https://[project-ref].supabase.co
# The anon / publishable key. Used only to call Supabase Auth on the user's behalf.
SUPABASE_ANON_KEY=
# Optional: the legacy JWT secret. Set only if your project still signs tokens with HS256.
# Projects on JWT signing keys (ES256/RS256) are verified via JWKS automatically.
SUPABASE_JWT_SECRET=
# Shared secret for POST /api/auth/webhook (must match the Vault secret in supabase/auth_webhook.sql).
SUPABASE_WEBHOOK_SECRET=
# Where Supabase sends users after GitHub / magic-link sign-in (tokens arrive in the URL fragment).
# AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Internal callers (job scraper, CV parser) send this as the X-Service-Key header.
SERVICE_API_KEY=

# Next.js origin. Used for CORS and redirect validation.
FRONTEND_URL=http://localhost:3000
# Comma-separated; defaults to FRONTEND_URL.
# ALLOWED_ORIGINS=http://localhost:3000,https://devledgr.xyz
# COOKIE_DOMAIN=.devledgr.xyz
# COOKIE_SECURE=true

# Claude for the ATS CV audit. Without a key, a rule-based scorer answers (engine: "heuristic").
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# >= 32 chars. Signs ledger certificates; rotating it invalidates existing stamps.
LEDGER_SIGNING_SECRET=
# 64 hex chars (32 bytes). Encrypts BYOK API keys. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Optional external AI gateway for /api/v1/ai/scrutiny and /api/v1/ai/coach.
AI_GATEWAY_URL=
